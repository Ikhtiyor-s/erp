# =========================================================
# Aniq ERP — Production environment template
# Copy to .env.production and fill in real values before deploy.
# DO NOT commit the filled file to git.
# =========================================================

# ----- Core -----
ENV=production
RELEASE=aniq-erp@v1.0
APP_NAME="Aniq ERP"

# 64-char hex string. Generate: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_TO_RANDOM_64_HEX

# ----- Database -----
DATABASE_URL=postgresql+asyncpg://erp:CHANGE_ME@postgres:5432/erp
POSTGRES_DB=erp
POSTGRES_USER=erp
POSTGRES_PASSWORD=CHANGE_ME

# ----- Redis (caching, future) -----
REDIS_URL=redis://redis:6379/0

# ----- Web -----
NEXT_PUBLIC_API_URL=https://YOUR_DOMAIN/api/v1

# ----- CORS (comma-separated allowed origins) -----
CORS_ORIGINS=https://YOUR_DOMAIN,https://www.YOUR_DOMAIN

# ----- Sentry (error tracking) -----
# Leave empty to disable
SENTRY_DSN=
SENTRY_TRACES_RATE=0.1

# ----- AI assistant -----
# Set EITHER Anthropic OR OpenAI (or both — Anthropic wins)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ----- Backup -----
BACKUP_DIR=/var/backups/aniq-erp
S3_BUCKET=                       # optional, requires aws cli

# ----- Telegram bot (configured per-org via UI, not env) -----
# ----- Click/Payme/Apelsin (configured per-org via UI) -----

# ----- pgAdmin (optional, disable in prod) -----
PGADMIN_DEFAULT_EMAIL=admin@aniq-erp.uz
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME
